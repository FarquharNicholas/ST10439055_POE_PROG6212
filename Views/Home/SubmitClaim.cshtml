@model ST10439055_POE_PROG6212.Models.ClaimSubmissionViewModel
@{
    ViewBag.Title = "Submit Claim";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card p-4">
            <div class="text-center mb-4">
                <h3 class="fw-bold text-primary">Submit Monthly Claim</h3>
                <p class="text-muted">Fill in your claim details below and submit with one click</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form asp-action="SubmitClaim" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="LecturerName" class="form-label fw-semibold"></label>
                        <input asp-for="LecturerName" class="form-control" placeholder="Enter your full name" />
                        <span asp-validation-for="LecturerName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="your.email@university.ac.za" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Department" class="form-label fw-semibold"></label>
                        <input asp-for="Department" class="form-control" placeholder="e.g., Computer Science" />
                        <span asp-validation-for="Department" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Month" class="form-label fw-semibold"></label>
                        <input asp-for="Month" type="month" class="form-control" />
                        <span asp-validation-for="Month" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="HoursWorked" class="form-label fw-semibold"></label>
                        <input asp-for="HoursWorked" class="form-control" type="number" placeholder="Enter hours worked" min="1" max="200" step="1" />
                        <span asp-validation-for="HoursWorked" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="HourlyRate" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text">R</span>
                            <input asp-for="HourlyRate" class="form-control" type="number" placeholder="0.00" min="0.01" max="1000" step="0.01" />
                        </div>
                        <span asp-validation-for="HourlyRate" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="card bg-light border-0 shadow-sm">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <p class="text-muted mb-1">Estimated Payout</p>
                                <h3 class="fw-bold text-primary mb-0" id="calculatedTotal">R0.00</h3>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-secondary" id="payoutStatus">Enter values to calculate</span>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-0 pt-0">
                            <small class="text-muted d-block" id="calculationMessage">
                                Provide hours worked and hourly rate to preview your payment before submitting.
                            </small>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Notes" class="form-label fw-semibold"></label>
                    <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Any additional notes or comments (optional)"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="SupportingDocument" class="form-label fw-semibold"></label>
                    <div class="file-upload-container">
                        <input asp-for="SupportingDocument" type="file" class="form-control" accept=".pdf,.docx,.xlsx,.doc,.xls" id="fileInput" />
                        <div class="file-info mt-2" id="fileInfo" style="display: none;">
                            <div class="alert alert-info d-flex align-items-center">
                                <i class="bi bi-file-earmark-text me-2"></i>
                                <span id="fileName"></span>
                                <button type="button" class="btn-close ms-auto" onclick="clearFile()"></button>
                            </div>
                        </div>
                    </div>
                    <small class="text-muted">Supported formats: PDF, DOCX, XLSX (Max 10MB)</small>
                    <span asp-validation-for="SupportingDocument" class="text-danger"></span>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-lg fw-semibold">
                        <i class="bi bi-send-fill me-2"></i>
                        Submit Claim
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function() {
            'use strict';
            window.addEventListener('load', function() {
                var forms = document.getElementsByClassName('needs-validation');
                var validation = Array.prototype.filter.call(forms, function(form) {
                    form.addEventListener('submit', function(event) {
                        if (form.checkValidity() === false) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
            }, false);
        })();

        const hoursInput = document.getElementById('HoursWorked');
        const rateInput = document.getElementById('HourlyRate');
        const totalDisplay = document.getElementById('calculatedTotal');
        const payoutStatus = document.getElementById('payoutStatus');
        const calcMessage = document.getElementById('calculationMessage');
        const numericOptions = {
            hours: { min: 1, max: 200 },
            rate: { min: 0.01, max: 1000 }
        };

        const formatCurrency = value => `R${value.toFixed(2)}`;

        function showStatus(message, variant) {
            payoutStatus.textContent = message;
            payoutStatus.className = `badge bg-${variant}`;
        }

        function updateCalculation() {
            const hours = parseFloat(hoursInput.value);
            const rate = parseFloat(rateInput.value);

            if (isNaN(hours) || isNaN(rate)) {
                totalDisplay.textContent = 'R0.00';
                showStatus('Enter values to calculate', 'secondary');
                calcMessage.textContent = 'Both fields must contain valid numbers.';
                return;
            }

            if (hours < numericOptions.hours.min || hours > numericOptions.hours.max) {
                showStatus('Hours outside allowed range', 'warning');
                calcMessage.textContent = `Hours must be between ${numericOptions.hours.min} and ${numericOptions.hours.max}.`;
                totalDisplay.textContent = 'R0.00';
                return;
            }

            if (rate < numericOptions.rate.min || rate > numericOptions.rate.max) {
                showStatus('Hourly rate outside allowed range', 'warning');
                calcMessage.textContent = `Hourly rate must be between R${numericOptions.rate.min.toFixed(2)} and R${numericOptions.rate.max.toFixed(2)}.`;
                totalDisplay.textContent = 'R0.00';
                return;
            }

            const total = hours * rate;
            totalDisplay.textContent = formatCurrency(total);
            showStatus('All good', 'success');
            calcMessage.textContent = 'Review the estimated payout before submitting your claim.';
        }

        [hoursInput, rateInput].forEach(input => {
            input?.addEventListener('input', updateCalculation);
            input?.addEventListener('blur', function() {
                if (!input.value) return;
                const value = parseFloat(input.value);
                const opts = input.id === 'HoursWorked' ? numericOptions.hours : numericOptions.rate;
                if (value < opts.min) {
                    input.value = opts.min;
                } else if (value > opts.max) {
                    input.value = opts.max;
                }
                updateCalculation();
            });
        });

        updateCalculation();

        document.getElementById('fileInput').addEventListener('change', function(e) {
            const file = e.target.files[0];
            const fileInfo = document.getElementById('fileInfo');
            const fileName = document.getElementById('fileName');
            
            if (file) {
                if (file.size > 10 * 1024 * 1024) {
                    alert('File size exceeds 10MB limit. Please choose a smaller file.');
                    e.target.value = '';
                    return;
                }
                
                const allowedTypes = ['.pdf', '.docx', '.xlsx', '.doc', '.xls'];
                const fileExtension = '.' + file.name.split('.').pop().toLowerCase();
                
                if (!allowedTypes.includes(fileExtension)) {
                    alert('Invalid file type. Please select a PDF, DOCX, or XLSX file.');
                    e.target.value = '';
                    return;
                }
                
                fileName.textContent = file.name;
                fileInfo.style.display = 'block';
            } else {
                fileInfo.style.display = 'none';
            }
        });

        function clearFile() {
            document.getElementById('fileInput').value = '';
            document.getElementById('fileInfo').style.display = 'none';
        }
    </script>
}
