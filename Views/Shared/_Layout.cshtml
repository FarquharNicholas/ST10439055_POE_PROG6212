<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - CMCS</title>

 
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background: linear-gradient(135deg, #f5f7fa, #e4ebf1);
            min-height: 100vh;
        }
        .navbar {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid #d0d0d0;
        }
        .card {
            border-radius: 18px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        }
        .btn-apple {
            background: #007aff;
            color: white;
            border-radius: 12px;
            font-weight: 500;
            padding: 8px 16px;
        }
        .btn-apple:hover {
            background: #005bb5;
            color: white;
        }
        .admin-card {
            transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
        }
        .admin-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        }
        .status-badge {
            font-size: 0.75rem;
            padding: 0.5rem 0.75rem;
        }
    </style>
</head>
<body>
@{
    var session = Context.Session;
    var userId = session.GetInt32(SessionKeys.UserId);
    var userRole = session.GetString(SessionKeys.UserRole);
    var isLoggedIn = userId.HasValue;
}
    <nav class="navbar navbar-expand-lg navbar-light">
        <div class="container">
            <a class="navbar-brand fw-bold" href="@Url.Action("Index", "Home")">CMCS</a>
            <div class="d-flex align-items-center gap-3">
                <ul class="navbar-nav me-3">
                    @if (isLoggedIn)
                    {
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Dashboard", "Home")">Dashboard</a></li>

                        @* HR SUPER USER: sees literally everything *@
                        @if (userRole == UserRole.HR.ToString())
                        {
                            <li class="nav-item"><a class="nav-link" href="@Url.Action("SubmitClaim", "Home")">Submit Claim</a></li>
                            <li class="nav-item"><a class="nav-link" href="@Url.Action("ViewClaims", "Home")">My Claims</a></li>
                            <li class="nav-item"><a class="nav-link" href="@Url.Action("CoordinatorReview", "Home")">Programme Coordinator</a></li>
                            <li class="nav-item"><a class="nav-link" href="@Url.Action("AcademicManagerReview", "Home")">Academic Manager</a></li>
                            <li class="nav-item"><a class="nav-link" href="@Url.Action("HRDashboard", "Home")">HR Dashboard</a></li>
                        }
                        else if (userRole == UserRole.Lecturer.ToString())
                        {
                            <li class="nav-item"><a class="nav-link" href="@Url.Action("SubmitClaim", "Home")">Submit Claim</a></li>
                            <li class="nav-item"><a class="nav-link" href="@Url.Action("ViewClaims", "Home")">My Claims</a></li>
                        }
                        else if (userRole == UserRole.ProgrammeCoordinator.ToString())
                        {
                            <li class="nav-item"><a class="nav-link" href="@Url.Action("CoordinatorReview", "Home")">Programme Coordinator</a></li>
                        }
                        else if (userRole == UserRole.AcademicManager.ToString())
                        {
                            <li class="nav-item"><a class="nav-link" href="@Url.Action("AcademicManagerReview", "Home")">Academic Manager</a></li>
                        }
                    }
                </ul>
                @if (isLoggedIn)
                {
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-box-arrow-right me-1"></i>Logout
                        </button>
                    </form>
                }
                else
                {
                    <a href="@Url.Action("Login", "Account")" class="btn btn-primary btn-sm">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
                    </a>
                }
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-octagon me-2"></i>
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["WarningMessage"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>
                @TempData["WarningMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
