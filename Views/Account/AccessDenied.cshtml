@{
    ViewBag.Title = "Access Denied";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0 mt-5">
            <div class="card-body text-center py-5">
                <i class="bi bi-shield-lock display-3 text-danger mb-3"></i>
                <h3 class="fw-bold mb-2">You don't have permission to view this page</h3>
                <p class="text-muted mb-4">
                    Please contact HR if you believe this is an error or you require additional permissions.
                </p>
                <a href="@Url.Action("Dashboard", "Home")" class="btn btn-outline-primary">
                    <i class="bi bi-arrow-left-circle me-2"></i>Return to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>

